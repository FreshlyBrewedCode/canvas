---
import FileText from "@lucide/astro/icons/file-text";
import type { MarkdownHeading } from "astro";
import NavDrawer from "../components/NavDrawer.astro";
import Sidebar from "../components/Sidebar.astro";
import Toc from "../components/Toc.astro";
import VersionPicker from "../components/VersionPicker.astro";
import { CHANNEL, CHANNELS, href } from "../lib/channel";
import Base from "./Base.astro";

interface Props {
  title: string;
  description?: string;
  slug: string;
  headings: MarkdownHeading[];
  canonical?: string;
}

const { title, description, slug, headings, canonical } = Astro.props;

// A page pointed elsewhere by `canonical` is the second copy of one that is
// already indexed at its own URL — Pagefind only picks up pages carrying a
// body marker, so withholding it keeps `/docs` out of the search results.
const indexable = canonical === undefined;
---

<Base title={`${title} — canvas`} description={description} canonical={canonical}>
  <NavDrawer slug={slug} headings={headings} />

  <div class="mx-auto max-w-6xl px-6 grid gap-10 lg:grid-cols-[13rem_minmax(0,1fr)_12rem]">
    <aside class="hidden lg:block py-10 sticky top-14 self-start max-h-[calc(100vh-3.5rem)] overflow-y-auto">
      <Sidebar current={slug} />
    </aside>

    <article class="py-10 min-w-0" data-pagefind-body={indexable ? true : undefined}>
      <header class="mb-8">
        {
          CHANNEL === "next" && (
            <p
              data-pagefind-ignore
              class="mb-6 rounded-md border border-dashed border-border-strong px-3 py-2 text-sm text-muted-foreground"
            >
              Pre-release docs, for <code class="font-mono text-foreground">@frebreco/canvas@next</code>.{" "}
              <a class="underline underline-offset-3 hover:text-foreground" href={`${CHANNELS.latest.base}/docs/${slug}`}
                data-fallback={`${CHANNELS.latest.base}/docs`}
              >
                Stable docs
              </a>
            </p>
          )
        }
        <div class="flex items-start justify-between gap-4">
          <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
          {/* Nothing else advertises the `.md` route, so link it. */}
          <a
            href={href(`/docs/${slug}.md`)}
            data-pagefind-ignore
            class="shrink-0 mt-1.5 inline-flex items-center gap-1.5 rounded-md border border-border px-2 py-1 font-mono text-xs text-muted-foreground hover:text-foreground hover:bg-accent"
          >
            <FileText class="size-3.5" />
            .md
          </a>
        </div>
        {description && <p class="mt-2 text-muted-foreground text-lg">{description}</p>}
      </header>

      {/* `prose-invert` is unnecessary: global.css binds prose to the tokens. */}
      <div class="prose max-w-none">
        <slot />
      </div>
    </article>

    <aside class="hidden lg:block py-10 sticky top-14 self-start max-h-[calc(100vh-3.5rem)] overflow-y-auto">
      <VersionPicker slug={slug} />
      <div class="mt-8">
        <Toc headings={headings} />
      </div>
    </aside>
  </div>
</Base>
