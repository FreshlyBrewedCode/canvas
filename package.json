    "@tanstack/ai-acp": "^0.3.17",
    "@tanstack/ai-sandbox": "^0.5.15",
    "@tanstack/ai-sandbox-local-process": "^0.2.6",
    "@trystero-p2p/ws-relay": "0.25.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.48.0",
    "partysocket": "1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.13.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
