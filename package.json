{
  "name": "canvas",
  "private": true,
  "description": "A multiplayer canvas for coding agents that run on your machine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreshlyBrewedCode/canvas.git"
  },
  "bin": {
    "canvas": "bin/canvas.js"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "bun src/cli.ts serve",
    "build": "vite build",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src bin scripts vite.config.ts package.json .releaserc.json",
    "format:check": "oxfmt --check src bin scripts vite.config.ts package.json .releaserc.json",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
